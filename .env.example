# Stripe — cards + Affirm (fallback when Chargebee is not configured)
# 1. Create a Stripe account: https://dashboard.stripe.com/register
# 2. Enable Affirm: Settings → Payment methods → Affirm
# 3. Copy keys from Developers → API keys

# Browser (safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Server only (Vercel env / local .env — never commit real secrets)
STRIPE_SECRET_KEY=sk_test_...

# Optional
STRIPE_CURRENCY=usd

# Crisp live chat (reply from the Crisp phone app)
# https://app.crisp.chat → Settings → Website settings → Website ID
VITE_CRISP_WEBSITE_ID=

# --- Chargebee (preferred cart checkout + skincare subscriptions) ---
# 1. Create a site: https://www.chargebee.com
# 2. Settings → Configure Chargebee → API Keys → full-access key
# 3. Settings → Configure Chargebee → Checkout & Self-Serve Portal → publishable key
# 4. Connect Stripe (or another gateway) and enable Affirm in Chargebee if desired
# 5. For skincare subscriptions, create a Plan item price and paste its id below

CHARGEBEE_SITE=your-site
VITE_CHARGEBEE_SITE=your-site
CHARGEBEE_API_KEY=full_access_key_...
VITE_CHARGEBEE_PUBLISHABLE_KEY=publishable_key_...

# Optional — Product Catalog 2.0 item price id for skincare membership
CHARGEBEE_SKINCARE_PLAN_PRICE_ID=skincare-ritual-USD-Monthly
VITE_CHARGEBEE_SKINCARE_PLAN_PRICE_ID=skincare-ritual-USD-Monthly

# Optional
CHARGEBEE_CURRENCY=USD

# --- Email (Resend) — order alerts + account confirmation ---
# 1. Create account: https://resend.com
# 2. Verify wellpept.com domain (DNS records Resend shows)
# 3. API Keys → Create → paste below
# 4. Add the same vars in Vercel → Settings → Environment Variables

RESEND_API_KEY=re_...
EMAIL_FROM=WellPept <info@wellpept.com>
EMAIL_OPS_TO=info@wellpept.com

# --- Manual pay-after-supply (Venmo / Zelle / crypto) ---
# Also configurable in Undisclosed Admin → Payment methods (saved in browser).
VITE_VENMO_HANDLE=
# QR / code link from Venmo (preferred), e.g. https://venmo.com/code?user_id=...
VITE_VENMO_CODE_URL=
VITE_ZELLE_CONTACT=
VITE_ZELLE_NAME=WellPept
VITE_CRYPTO_SOLANA_USDC=
VITE_CRYPTO_ETH_USDC=
VITE_MANUAL_PAY_NOTE=Include your order ID in the payment memo. USDC or USDT accepted on the listed networks.
